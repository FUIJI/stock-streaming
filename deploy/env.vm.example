# Copy to ~/docker/stock-streaming/.env on the VM (chmod 600). Never commit the real file.
# Values here are placeholders: replace every "change-me".

# ---------- Market data ----------
TRADE_SOURCE=alpaca
ALPACA_API_KEY=change-me
ALPACA_API_SECRET=change-me
ALPACA_FEED=iex
# History for backfill/reconcile: sip (all exchanges; free plan except the last 15 min) | iex
ALPACA_HISTORY_FEED=sip
# Nightly reconcile (UTC, after after-hours ends); "off" disables
RECONCILE_AT_UTC=01:30
SYMBOLS=AAPL,MSFT,NVDA,TSLA

# ---------- Lite stack ----------
# openssl rand -hex 32
INGEST_TOKEN=change-me

# ---------- Postgres (container on the VM) ----------
POSTGRES_USER=stock
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocks

# ---------- API ----------
# Comma-separated browser origins allowed to call the API (your Vercel URL)
CORS_ORIGINS=https://change-me.vercel.app
