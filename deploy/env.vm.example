# Copy to ~/docker/stock-streaming/.env on the VM (chmod 600). Never commit the real file.
# Values here are placeholders: replace every "change-me".

# ---------- Market data ----------
TRADE_SOURCE=alpaca
ALPACA_API_KEY=change-me
ALPACA_API_SECRET=change-me
ALPACA_FEED=iex
# History for backfill/reconcile: sip (all exchanges; free plan except the last 15 min) | iex
ALPACA_HISTORY_FEED=sip
# Nightly reconcile (UTC, after after-hours ends); "off" disables
RECONCILE_AT_UTC=01:30
SYMBOLS=AAPL,MSFT,NVDA,TSLA

# ---------- Lite stack ----------
# openssl rand -hex 32
INGEST_TOKEN=change-me

# ---------- Postgres (container on the VM) ----------
POSTGRES_USER=stock
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocks

# ---------- API ----------
# Comma-separated browser origins allowed to call the API (your Vercel URL)
CORS_ORIGINS=https://change-me.vercel.app
# Optional: also allow this project's Vercel preview URLs (they change on every deploy)
# CORS_ORIGIN_REGEX=https://stock-streaming-[a-z0-9]+-fuiji\.vercel\.app

# ---------- News + AI (docs/specs/phase-3c-news.md, phase-3d-news-digest.md) ----------
# Free key: https://aistudio.google.com -> Get API key (keep the project on the free tier).
# Empty = no AI: articles are still stored and shown in English.
GEMINI_API_KEY=change-me
# LLM_PROVIDER=gemini                # gemini | off
# LLM_MODEL=gemma-4-26b-a4b-it       # primary (free: 30 req/min, 16K tokens/min, 14.4K/day)
# LLM_FALLBACK_MODEL=gemini-3.8-flash  # used on overload/timeouts only (free: 20/day); empty = none
# LLM_TEMPERATURE=0.2                # Gemma looped at the default (~1.0) and at 0
# LLM_THINKING_LEVEL=low             # gemini-* models only
# LLM_TIMEOUT_SEC=300
# LLM_DAILY_CALL_LIMIT=200           # our own cap, below Google's
# LLM_RPM_LIMIT=2                    # a 25-article batch is ~5.5K tokens; Gemma allows 16K/min
# Triage: scores + one-line Thai headline, many articles per call
# LLM_TRIAGE_BATCH=25                # lower (e.g. 10) if answers break or get cut off
# LLM_TRIAGE_WAIT_SEC=45             # fresh articles wait this long to share a call
# LLM_MAX_TOKENS_BASE=1024
# LLM_MAX_TOKENS_PER_ARTICLE=200
# NEWS_POLL_SEC=60                   # 0 disables the Alpaca news poller
# NEWS_BACKFILL_DAYS=3               # first start only
# NEWS_MAX_TAGS=5                    # more tagged symbols = market roundup, never sent to the AI
# NEWS_WORKER_IDLE_SEC=15
# Outlook cards: per symbol, written at these New York times when its news changed
# DIGEST_TIMES_ET=08:45,12:30,16:30
# LLM_DIGEST_RESERVE=60              # triage stops this many calls short of the daily cap
# LLM_DIGEST_MAX_TOKENS=2048         # English card
# LLM_TRANSLATE_MAX_TOKENS=2048      # its Thai translation
# OUTLOOK_FLAT_PCT=1.0               # accuracy: a 3-session move within ±this % is "mixed"
